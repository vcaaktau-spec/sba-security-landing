{
  "name": "shadcn-landing-page-template",
  "description": "Landing page template utilizing Shadcn, React, Typescript, and Tailwind CSS for rapid development and responsive design.",
  "author": {
    "name": "Leopoldo Miranda",
    "email": "leomirandadev@gmail.com",
    "url": "https://github.com/leoMirandaa"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "shadcn",
    "shadcn/ui",
    "tailwind",
    "landing-page",
    "template",
    "responsive-design"
  ],
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node -e \"if(!process.env.VERCEL && !process.env.CI){require('child_process').execSync('react-snap',{stdio:'inherit'})}else{console.log('react-snap: skipped in CI')}\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "crawl": false,
    "include": ["/", "/uslugi/videonahljudenie", "/uslugi/skud", "/uslugi/signalizaciya", "/uslugi/seti"],
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "minifyHtml": false,
    "saveAs": "html"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@clerk/localizations": "^4.2.1",
    "@clerk/react": "^6.1.0",
    "@clerk/themes": "^2.4.57",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.35.0",
    "i18next": "^25.8.14",
    "konva": "9.3.6",
    "lenis": "^1.3.18",
    "lucide-react": "^0.424.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.6",
    "react-intersection-observer": "^10.0.3",
    "react-konva": "18.2.10",
    "react-parallax-tilt": "^1.7.319",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.38",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
